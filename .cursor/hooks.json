{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python .cursor/hooks/session_start.py",
        "timeout": 10
      },
      {
        "command": "python .cursor/hooks/sync_gitignore.py",
        "timeout": 10
      }
    ],
    "afterFileEdit": [
      {
        "command": "python .cursor/hooks/sync_gitignore.py",
        "timeout": 10
      }
    ],
    "subagentStart": [
      {
        "command": "python .cursor/hooks/subagent_start.py",
        "timeout": 15
      }
    ],
    "subagentStop": [
      {
        "command": "python .cursor/hooks/subagent_stop.py",
        "timeout": 15,
        "loop_limit": 3
      }
    ],
    "preToolUse": [
      {
        "command": "python .cursor/hooks/log_task_delegation.py",
        "matcher": "Task",
        "timeout": 10
      },
      {
        "command": "python .cursor/hooks/protect_done_milestones.py",
        "matcher": "Write|Delete|StrReplace",
        "timeout": 10
      }
    ],
    "postToolUse": [
      {
        "command": "python .cursor/hooks/log_task_result.py",
        "matcher": "Task",
        "timeout": 10
      },
      {
        "command": "python .cursor/hooks/warn_out_of_scope.py",
        "matcher": "Write|StrReplace",
        "timeout": 10
      }
    ],
    "afterAgentResponse": [
      {
        "command": "python .cursor/hooks/log_agent_response.py",
        "matcher": "AgentResponse",
        "timeout": 10
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python .cursor/hooks/block_git_push.py",
        "matcher": "git push",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "afterShellExecution": [
      {
        "command": "python .cursor/hooks/sync_gitignore.py",
        "timeout": 10
      }
    ]
  }
}
